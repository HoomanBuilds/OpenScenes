{
  "name": "THE NEURAL NEXUS (Ultimate)",
  "description": "A fully unescaped, object-based masterpiece. Features Recharts, SVG Animation, 3D Transforms, and 'Smart' ID-based choreography.",
  "slides": [
    {
      "id": "slide-ulti-1",
      "type": "default",
      "duration": 600,
      "background": { "type": "color", "value": "#050505" },
      "elements": [
        {
          "id": "el-ultima",
          "type": "custom",
          "x": 0,
          "y": 0,
          "width": 1000,
          "height": 562,
          "zIndex": 10,
          "content": {
            "layout": {
              "tag": "div",
              "className": "w-full h-full relative overflow-hidden bg-black perspective-[1000px] font-mono",
              "children": [
                {
                  "id": "grid-floor",
                  "tag": "div",
                  "className": "absolute inset-0 opacity-20 origin-bottom",
                  "style": {
                    "backgroundImage": "linear-gradient(to right, #333 1px, transparent 1px), linear-gradient(to bottom, #333 1px, transparent 1px)",
                    "backgroundSize": "40px 40px",
                    "transform": "rotateX(60deg) scale(2)"
                  }
                },
                {
                  "id": "cyber-sun",
                  "tag": "div",
                  "className": "absolute top-[-100px] left-[350px] w-[300px] h-[300px] rounded-full bg-gradient-to-b from-blue-500/20 to-purple-900/0 blur-[60px]"
                },
                {
                  "id": "connector-lines",
                  "tag": "svg",
                  "className": "absolute inset-0 w-full h-full z-10 pointer-events-none",
                  "children": [
                    { "id": "line-1", "tag": "path", "props": { "d": "M150,200 L500,280", "stroke": "#3b82f6", "strokeWidth": "2", "fill": "none", "strokeDasharray": "10 5" } },
                    { "id": "line-2", "tag": "path", "props": { "d": "M850,200 L500,280", "stroke": "#a855f7", "strokeWidth": "2", "fill": "none", "strokeDasharray": "10 5" } },
                    { "id": "line-3", "tag": "path", "props": { "d": "M500,450 L500,280", "stroke": "#22c55e", "strokeWidth": "2", "fill": "none", "strokeDasharray": "10 5" } }
                  ]
                },
                {
                  "id": "node-center",
                  "tag": "div",
                  "className": "absolute top-[230px] left-[450px] w-[100px] h-[100px] bg-black border border-white/20 rounded-full flex items-center justify-center z-20 shadow-[0_0_50px_#3b82f6]",
                  "children": [
                    { "tag": "div", "className": "w-3 h-3 bg-white rounded-full animate-ping" }
                  ]
                },
                {
                  "id": "card-left",
                  "tag": "div",
                  "className": "absolute top-[100px] left-[50px] w-[250px] h-[200px] bg-zinc-900/80 border border-blue-500/30 rounded-lg p-4 backdrop-blur-md z-20 overflow-hidden",
                  "children": [
                    { "tag": "div", "className": "text-[10px] text-blue-400 mb-2", "text": "SECTOR_ALPHA // LOAD" },
                    {
                      "tag": "ResponsiveContainer", "props": { "width": "100%", "height": 140 },
                      "children": [
                        { "tag": "AreaChart", "props": { "data": [{ "v": 10 }, { "v": 40 }, { "v": 20 }, { "v": 70 }, { "v": 50 }, { "v": 90 }, { "v": 30 }] },
                          "children": [
                            { "tag": "Area", "props": { "type": "monotone", "dataKey": "v", "stroke": "#3b82f6", "fill": "#3b82f6", "fillOpacity": 0.2 } }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "card-right",
                  "tag": "div",
                  "className": "absolute top-[100px] right-[50px] w-[250px] h-[200px] bg-zinc-900/80 border border-purple-500/30 rounded-lg p-4 backdrop-blur-md z-20 overflow-hidden",
                  "children": [
                    { "tag": "div", "className": "text-[10px] text-purple-400 mb-2", "text": "SECTOR_BETA // COMP" },
                    {
                      "tag": "ResponsiveContainer", "props": { "width": "100%", "height": 140 },
                      "children": [
                        { "tag": "PieChart",
                          "children": [
                            { "tag": "Pie", "props": { "data": [{ "name": "A", "value": 400 }, { "name": "B", "value": 300 }, { "name": "C", "value": 300 }], "dataKey": "value", "innerRadius": 40, "outerRadius": 60, "stroke": "none" },
                              "children": [
                                { "tag": "Cell", "props": { "fill": "#a855f7" } },
                                { "tag": "Cell", "props": { "fill": "#d8b4fe" } },
                                { "tag": "Cell", "props": { "fill": "#581c87" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "card-bottom",
                  "tag": "div",
                  "className": "absolute bottom-[50px] left-[300px] w-[400px] h-[80px] bg-zinc-900/80 border border-green-500/30 rounded-lg flex items-center px-6 justify-between backdrop-blur-md z-20",
                  "children": [
                    { "tag": "div", "className": "text-xs text-green-400", "text": "SYSTEM_STATUS: ONLINE" },
                    { "tag": "div", "className": "flex gap-1", "children": [
                        { "tag": "div", "className": "w-2 h-6 bg-green-500/50" },
                        { "tag": "div", "className": "w-2 h-6 bg-green-500/50" },
                        { "tag": "div", "className": "w-2 h-6 bg-green-500/50" },
                        { "tag": "div", "className": "w-2 h-6 bg-green-500 animate-pulse" }
                    ]}
                  ]
                }
              ]
            },
            "animations": {
              "grid-floor": {
                "initial": { "opacity": 0, "rotateX": 90 },
                "animate": { "opacity": 0.3, "rotateX": 60 },
                "transition": { "duration": 3 }
              },
              "card-left": {
                "initial": { "x": -100, "opacity": 0 },
                "animate": { "x": 0, "opacity": 1 },
                "transition": { "delay": 1, "duration": 1, "type": "spring" }
              },
              "card-right": {
                "initial": { "x": 100, "opacity": 0 },
                "animate": { "x": 0, "opacity": 1 },
                "transition": { "delay": 1.5, "duration": 1, "type": "spring" }
              },
              "card-bottom": {
                "initial": { "y": 100, "opacity": 0 },
                "animate": { "y": 0, "opacity": 1 },
                "transition": { "delay": 2, "duration": 1 }
              },
              "node-center": {
                "initial": { "scale": 0 },
                "animate": { "scale": 1 },
                "transition": { "delay": 3, "type": "spring", "stiffness": 200 }
              },
              "line-1": {
                "initial": { "pathLength": 0, "opacity": 0 },
                "animate": { "pathLength": 1, "opacity": 1 },
                "transition": { "delay": 3.5, "duration": 1 }
              },
              "line-2": {
                "initial": { "pathLength": 0, "opacity": 0 },
                "animate": { "pathLength": 1, "opacity": 1 },
                "transition": { "delay": 3.7, "duration": 1 }
              },
              "line-3": {
                "initial": { "pathLength": 0, "opacity": 0 },
                "animate": { "pathLength": 1, "opacity": 1 },
                "transition": { "delay": 3.9, "duration": 1 }
              }
            }
          }
        }
      ]
    }
  ]
}
