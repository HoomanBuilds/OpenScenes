{
    "name": "API Key Dashboard Flow",
    "description": "A simulation of a user navigating a dashboard to generate and copy an API key.",
    "slides": [
      {
        "id": "slide-api-flow",
        "type": "default",
        "duration": 10000,
        "background": {
          "type": "color",
          "value": "#000000"
        },
        "elements": [
          {
            "id": "el-dashboard-demo",
            "type": "custom",
            "x": 0,
            "y": 0,
            "width": 1000,
            "height": 562.5,
            "zIndex": 10,
            "content": {
                "layout": {
                    "tag": "div",
                    "className": "w-full h-full flex items-center justify-center bg-gradient-to-br from-zinc-950 via-black to-zinc-900 overflow-hidden",
                    "children": [
                        {
                            "tag": "div",
                            "className": "w-[85%] h-[80%] flex bg-black text-white overflow-hidden relative font-sans rounded-xl border border-zinc-700/50 shadow-2xl",
                            "children": [
                        {
                            "tag": "div",
                            "className": "w-64 bg-zinc-900 border-r border-zinc-800 flex flex-col p-4 gap-2",
                            "children": [
                                { "tag": "div", "className": "h-8 w-24 bg-zinc-700/50 rounded mb-6" },
                                { 
                                    "id": "sidebar-item-dashboard",
                                    "tag": "div", 
                                    "className": "h-10 w-full rounded flex items-center px-3 text-zinc-400 gap-3",
                                    "children": [
                                        { "tag": "div", "className": "w-4 h-4 bg-zinc-600 rounded-sm" },
                                        { "tag": "span", "text": "Dashboard", "className": "text-sm font-medium" }
                                    ] 
                                },
                                { 
                                    "id": "sidebar-item-keys",
                                    "tag": "div", 
                                    "className": "h-10 w-full rounded flex items-center px-3 text-zinc-400 gap-3 transition-colors",
                                    "children": [
                                        { "tag": "div", "className": "w-4 h-4 bg-zinc-600 rounded-sm" },
                                        { "tag": "span", "text": "API Keys", "className": "text-sm font-medium" }
                                    ] 
                                },
                                { 
                                    "tag": "div", 
                                    "className": "h-10 w-full rounded flex items-center px-3 text-zinc-400 gap-3",
                                    "children": [
                                        { "tag": "div", "className": "w-4 h-4 bg-zinc-600 rounded-sm" },
                                        { "tag": "span", "text": "Settings", "className": "text-sm font-medium" }
                                    ] 
                                }
                            ]
                        },
                        {
                            "tag": "div",
                            "className": "flex-1 relative",
                            "children": [
                                {
                                    "id": "view-dashboard",
                                    "tag": "div",
                                    "className": "absolute inset-0 p-8",
                                    "children": [
                                        { "tag": "h1", "className": "text-2xl font-bold mb-6", "text": "Dashboard" },
                                        { "tag": "div", "className": "grid grid-cols-3 gap-6", "children": [
                                            { "tag": "div", "className": "h-32 bg-zinc-900 border border-zinc-800 rounded-xl" },
                                            { "tag": "div", "className": "h-32 bg-zinc-900 border border-zinc-800 rounded-xl" },
                                            { "tag": "div", "className": "h-32 bg-zinc-900 border border-zinc-800 rounded-xl" }
                                        ]}
                                    ]
                                },
                                {
                                    "id": "view-keys",
                                    "tag": "div",
                                    "className": "absolute inset-0 p-8 opacity-0",
                                    "children": [
                                        { 
                                            "tag": "div", 
                                            "className": "flex justify-between items-center mb-8",
                                            "children": [
                                                { "tag": "h1", "className": "text-2xl font-bold", "text": "API Keys" },
                                                { 
                                                    "id": "btn-create",
                                                    "tag": "button", 
                                                    "className": "bg-white text-black px-4 py-2 rounded-lg text-sm font-medium hover:bg-zinc-200 transition-transform origin-center",
                                                    "text": "Create New Key" 
                                                }
                                            ]
                                        },
                                        { "tag": "div", "className": "space-y-4", "children": [
                                            { 
                                                "tag": "div", 
                                                "className": "h-16 bg-zinc-900 border border-zinc-800 rounded-xl flex items-center px-4 justify-between",
                                                "children": [
                                                    { "tag": "div", "className": "flex flex-col", "children": [
                                                        { "tag": "span", "className": "text-sm font-medium text-white", "text": "Production Key" },
                                                        { "tag": "span", "className": "text-xs text-zinc-500", "text": "sk_live_...4829" }
                                                    ]},
                                                    { "tag": "div", "className": "text-xs text-zinc-500", "text": "Active" }
                                                ]
                                            }
                                        ]}
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "overlay",
                            "tag": "div",
                            "className": "absolute inset-0 bg-black/60 opacity-0 flex items-center justify-center backdrop-blur-sm pointer-events-none z-40",
                            "children": [
                                {
                                    "id": "popup",
                                    "tag": "div",
                                    "className": "w-[400px] bg-zinc-900 border border-zinc-700 rounded-xl p-6 shadow-2xl scale-95 opacity-0",
                                    "children": [
                                        { "tag": "h2", "className": "text-lg font-bold mb-2", "text": "New API Key Created" },
                                        { "tag": "p", "className": "text-zinc-400 text-sm mb-4", "text": "Please copy your key now. You won't be able to see it again." },
                                        { 
                                            "tag": "div", 
                                            "className": "flex gap-2 mb-4", 
                                            "children": [
                                                { "tag": "div", "className": "flex-1 bg-black border border-zinc-700 rounded p-2 text-sm text-zinc-300 font-mono truncate", "text": "sk_live_51MzQ..." },
                                                { 
                                                    "id": "btn-copy",
                                                    "tag": "button", 
                                                    "className": "bg-zinc-800 hover:bg-zinc-700 text-white px-3 py-2 rounded text-sm font-medium transition-colors border border-zinc-700",
                                                    "text": "Copy" 
                                                }
                                            ] 
                                        },
                                        { 
                                            "tag": "div", 
                                            "className": "flex justify-end",
                                            "children": [
                                                  { "tag": "button", "className": "text-zinc-500 text-sm hover:text-white", "text": "Done" }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "cursor",
                            "tag": "div",
                            "className": "absolute top-0 left-0 w-6 h-6 z-50 pointer-events-none drop-shadow-2xl",
                            "children": [
                                {
                                    "tag": "svg",
                                    "props": {
                                        "viewBox": "0 0 24 24",
                                        "fill": "none",
                                        "xmlns": "http://www.w3.org/2000/svg"
                                    },
                                    "className": "w-full h-full",
                                    "children": [
                                        { "tag": "path", "props": { "d": "M3 3L10.07 19.97L12.58 12.58L19.97 10.07L3 3Z", "fill": "white", "stroke": "black", "strokeWidth": "1.5", "strokeLinejoin": "round" } }
                                    ]
                                }
                            ]
                        }
                    ]
                        }
                    ]
                },
                "animations": {
                    "cursor": {
                        "initial": { "x": 500, "y": 300, "opacity": 1 }
                    }
                },
                "timeline": [
                    { "label": "Start" },
                    { "delay": 0.2 },
                    
                    { "comment": "Move cursor to API Keys link" },
                    { 
                        "id": "cursor", 
                        "animate": { "x": "target:sidebar-item-keys", "y": "target:sidebar-item-keys" }, 
                        "transition": { "duration": 0.8, "ease": "easeOut" } 
                    },
                    
                    { "comment": "Click visual feedback" },
                    { 
                        "id": "cursor", 
                        "animate": { "scale": 0.9 }, 
                        "transition": { "duration": 0.1, "yoyo": true, "repeat": 1 } 
                    },
                    { 
                        "id": "sidebar-item-keys", 
                        "animate": { "backgroundColor": "#27272a", "color": "#ffffff" }, 
                        "transition": { "duration": 0.1 } 
                    },

                    { "comment": "Switch Views" },
                    { 
                        "id": "view-dashboard", 
                        "animate": { "opacity": 0, "filter": "blur(4px)" }, 
                        "transition": { "duration": 0.3 } 
                    },
                    { 
                        "id": "view-keys", 
                        "animate": { "opacity": 1, "filter": "blur(0px)" }, 
                        "transition": { "duration": 0.4, "delay": 0.1 } 
                    },
                    { "delay": 0.5 },

                    { "comment": "Move cursor to Create Button" },
                    { 
                        "id": "cursor", 
                        "animate": { "x": "target:btn-create", "y": "target:btn-create" }, 
                        "transition": { "duration": 0.8, "ease": "easeInOut" } 
                    },

                    { "comment": "Click Create" },
                    { 
                        "id": "cursor", 
                        "animate": { "scale": 0.9 }, 
                        "transition": { "duration": 0.1, "yoyo": true, "repeat": 1 } 
                    },
                     { 
                        "id": "btn-create", 
                        "animate": { "scale": 0.95 }, 
                        "transition": { "duration": 0.1, "yoyo": true, "repeat": 1 } 
                    },

                    { "comment": "Show Popup" },
                    { 
                        "id": "overlay", 
                        "animate": { "opacity": 1 }, 
                        "transition": { "duration": 0.3 } 
                    },
                    { 
                        "id": "popup", 
                        "animate": { "opacity": 1, "scale": 1 }, 
                        "transition": { "duration": 0.4, "type": "spring", "bounce": 0.3 } 
                    },

                    { "comment": "Move cursor to Copy Button" },
                    { 
                        "id": "cursor", 
                        "animate": { "x": "target:btn-copy", "y": "target:btn-copy" }, 
                        "transition": { "duration": 0.6, "ease": "easeOut" } 
                    },

                    { "comment": "Click Copy" },
                     { 
                        "id": "cursor", 
                        "animate": { "scale": 0.9 }, 
                        "transition": { "duration": 0.1, "yoyo": true, "repeat": 1 } 
                    },
                    { 
                        "id": "btn-copy", 
                        "animate": { "backgroundColor": "#10b981", "borderColor": "#10b981" }, 
                        "transition": { "duration": 0.1 } 
                    },
                    
                    { "delay": 1.5 },

                    { "comment": "Reset State" },
                    { 
                        "id": "overlay", 
                        "animate": { "opacity": 0 }, 
                        "transition": { "duration": 0.5 } 
                    },
                    { 
                        "id": "popup", 
                        "animate": { "opacity": 0, "scale": 0.95 }, 
                        "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                    { 
                        "id": "view-keys", 
                        "animate": { "opacity": 0, "filter": "blur(4px)" }, 
                        "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                     { 
                        "id": "view-dashboard", 
                        "animate": { "opacity": 1, "filter": "blur(0px)" }, 
                        "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                    { 
                        "id": "btn-copy", 
                        "animate": { "backgroundColor": "#27272a", "borderColor": "#3f3f46" }, 
                        "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                    { 
                        "id": "sidebar-item-keys", 
                        "animate": { "backgroundColor": "transparent", "color": "#a1a1aa" }, 
                        "transition": { "duration": 0.5 },
                         "parallel": true
                    },
                    { 
                        "id": "cursor", 
                        "animate": { "x": 500, "y": 300 }, 
                        "transition": { "duration": 1, "ease": "easeInOut" },
                        "parallel": true
                    },

                    { "delay": 1 },
                    { "goto": "Start" }
                ]
            
            }
          }
        ]
      }
    ]
}
