{
    "name": "Hyper-Choreography: The AI Core",
    "description": "ULTIMATE EDITION with Upstash Aesthetics: Cinematic Grid -> Glitch Core -> Visual Data Stream -> Sexy Dashboard Image.",
    "slides": [
      {
        "id": "slide-hyper-1",
        "type": "default",
        "duration": 400,
        "background": {
          "type": "color",
          "value": "#000000"
        },
        "elements": [
          {
            "id": "el-hyper-scene",
            "type": "custom",
            "x": 0,
            "y": 0,
            "width": 1000,
            "height": 562,
            "zIndex": 10,
            "content": {
                "layout": {
                    "tag": "div",
                    "className": "w-full h-full flex items-center justify-center perspective-[1000px] overflow-hidden bg-black",
                    "children": [
                        {
                            "id": "bg-gradient",
                            "tag": "div",
                            "className": "absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-900/20 via-black to-black opacity-50"
                        },
                        {
                            "id": "core-orb",
                            "tag": "div",
                            "className": "w-32 h-32 bg-white rounded-full absolute z-20 blur-[2px] flex items-center justify-center shadow-[0_0_100px_rgba(59,130,246,0.5)]",
                            "children": [
                                { "tag": "div", "className": "w-20 h-20 bg-black rounded-full" }
                            ]
                        },
                        {
                            "id": "float-bar-1",
                            "tag": "div",
                            "className": "absolute right-[200px] top-[150px] w-64 h-16 bg-zinc-900 border border-zinc-800 rounded flex items-center px-4 space-x-4 z-10",
                            "children": [
                                { "tag": "div", "className": "w-8 h-8 rounded bg-blue-500/20 animate-pulse" },
                                { "tag": "div", "className": "h-2 w-32 bg-zinc-800 rounded" }
                            ]
                        },
                        {
                            "id": "float-bar-2",
                            "tag": "div",
                            "className": "absolute left-[200px] top-[250px] w-64 h-16 bg-zinc-900 border border-zinc-800 rounded flex items-center px-4 space-x-4 z-10",
                            "children": [
                                { "tag": "div", "className": "w-8 h-8 rounded bg-purple-500/20 animate-pulse" },
                                { "tag": "div", "className": "h-2 w-32 bg-zinc-800 rounded" }
                            ]
                        },
                        {
                            "id": "float-bar-3",
                            "tag": "div",
                            "className": "absolute top-[350px] w-64 h-16 bg-zinc-900 border border-zinc-800 rounded flex items-center px-4 space-x-4 z-10",
                            "children": [
                                { "tag": "div", "className": "w-8 h-8 rounded bg-green-500/20 animate-pulse" },
                                { "tag": "div", "className": "h-2 w-32 bg-zinc-800 rounded" }
                            ]
                        },
                        {
                            "id": "dashboard-card",
                            "tag": "div",
                            "className": "w-[800px] h-[500px] bg-zinc-950 border border-zinc-800 rounded-xl shadow-2xl absolute z-30 flex flex-col overflow-hidden",
                            "children": [
                                {
                                    "tag": "div", "className": "h-12 border-b border-zinc-800 flex items-center px-6 justify-between bg-zinc-900/50",
                                    "children": [
                                        { "tag": "div", "className": "text-sm font-bold text-white tracking-widest", "text": "CORE_SYSTEM_V2" },
                                        { "tag": "div", "className": "flex space-x-2", "children": [
                                            { "tag": "div", "className": "w-3 h-3 rounded-full bg-red-500" },
                                            { "tag": "div", "className": "w-3 h-3 rounded-full bg-yellow-500" },
                                            { "tag": "div", "className": "w-3 h-3 rounded-full bg-green-500" }
                                        ]}
                                    ]
                                },
                                {
                                    "tag": "div", "className": "flex-1 p-8 grid grid-cols-3 gap-6 relative",
                                    "children": [
                                        {
                                            "tag": "div", "className": "col-span-2 h-full bg-zinc-900 rounded-lg border border-zinc-800 relative overflow-hidden group",
                                            "children": [
                                                { "tag": "img", "className": "w-full h-full object-cover opacity-80", "props": { "src": "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1000" } }
                                            ]
                                        },
                                        {
                                            "tag": "div", "className": "space-y-6",
                                            "children": [
                                                { "tag": "div", "className": "h-28 bg-zinc-900 rounded-lg border border-zinc-800" },
                                                { "tag": "div", "className": "h-28 bg-zinc-900 rounded-lg border border-zinc-800" }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "animations": {
                    "bg-gradient": { "initial": { "opacity": 0 } },
                    "core-orb": { "initial": { "scale": 0, "opacity": 0, "y": 50 } },
                    "float-bar-1": { "initial": { "x": 200, "opacity": 0 } },
                    "float-bar-2": { "initial": { "x": -200, "opacity": 0 } },
                    "float-bar-3": { "initial": { "y": 200, "opacity": 0 } },
                    "dashboard-card": { "initial": { "opacity": 0, "scale": 0.8, "rotateX": 45 } }
                },
                "timeline": [
                    { "label": "Start" },
                    { "id": "bg-gradient", "animate": { "opacity": 0.5 }, "transition": { "duration": 2 } },
                    { "id": "core-orb", "animate": { "scale": 1, "opacity": 1, "y": 0 }, "transition": { "duration": 1.5, "type": "spring" } },
                    { "delay": 0.5 },
                    { "id": "float-bar-1", "animate": { "x": 0, "opacity": 1 }, "transition": { "duration": 1, "type": "spring" } },
                    { "delay": 0.2 },
                    { "id": "float-bar-2", "animate": { "x": 0, "opacity": 1 }, "transition": { "duration": 1, "type": "spring" } },
                    { "delay": 0.2 },
                    { "id": "float-bar-3", "animate": { "y": 150, "opacity": 1 }, "transition": { "duration": 1, "type": "spring" } },
                    { "delay": 1 },
                    { 
                        "id": "core-orb", "animate": { "scale": 5, "opacity": 0 }, "transition": { "duration": 1 } 
                    },
                    { 
                        "id": "float-bar-1", "animate": { "opacity": 0 }, "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                     { 
                        "id": "float-bar-2", "animate": { "opacity": 0 }, "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                     { 
                        "id": "float-bar-3", "animate": { "opacity": 0 }, "transition": { "duration": 0.5 },
                        "parallel": true
                    },
                    { "delay": 0.5 },
                    { 
                        "id": "dashboard-card", 
                        "animate": { "opacity": 1, "scale": 1, "rotateX": 0 }, 
                        "transition": { "duration": 1.5, "type": "spring" } 
                    }
                ]
            }
          }
        ]
      }
    ]
}
