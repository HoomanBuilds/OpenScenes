{
    "name": "Rotation Stress Test",
    "description": "A spinning card to test frame-by-frame animation smoothness.",
    "slides": [
        {
            "id": "stress-test-slide",
            "type": "custom",
            "duration": 5000,
            "background": { "type": "color", "value": "#050505" },
            "elements": [
                {
                    "id": "spinning-card-container",
                    "type": "custom",
                    "x": 0,
                    "y": 0,
                    "width": 1000,
                    "height": 562.5,
                    "zIndex": 10,
                    "content": {
                        "layout": {
                            "tag": "div",
                            "className": "w-full h-full flex items-center justify-center perspective-[1000px]",
                            "children": [
                                {
                                    "id": "coin",
                                    "tag": "div",
                                    "className": "w-64 h-64 bg-zinc-800 border-4 border-zinc-600 rounded-full flex items-center justify-center shadow-[0_0_50px_rgba(255,255,255,0.1)]",
                                    "children": [
                                        { "tag": "div", "className": "text-4xl font-black text-white", "text": "SPIN" }
                                    ]
                                }
                            ]
                        },
                        "animations": {
                            "coin": {
                                "initial": { "rotateY": 0, "scale": 1 }
                            }
                        },
                        "timeline": [
                            { "delay": 0.5 },
                            {
                                "id": "coin",
                                "animate": { "rotateY": 1800 },
                                "transition": { "duration": 4, "ease": "linear" }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
