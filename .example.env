PORT=3000
NODE_ENV="development"
REMOTION_OUTPUT_DIR=out

DATABASE_URL="postgresql://clarity:clarity_pass@localhost:5432/clarity"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL=amqp://vinit:vinit123@localhost:5672
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost

AUTH_SECRET=vinit123_secret_here
AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLOUD_PROJECT="projectId"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

ENABLE_IMAGEN=false
ENABLE_AI_IMAGES=false

LANGFUSE_SECRET_KEY="langfuse_secret_key"
LANGFUSE_PUBLIC_KEY="langfuse_public_key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

CONCURRENT_RENDERS=2
CONCURRENT_AI_JOBS=3

DEEPSEEK_API_KEY="deepseek_api_key"
